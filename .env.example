# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase dashboard → Connect → App Frameworks (or Settings → API).

# Your project URL, e.g. https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE (public / anon) key — safe to expose, protected by Row Level Security.
# Do NOT put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ============================================================================
# Multi-channel OTP auth (WhatsApp → SMS → Voice). All server-side (no NEXT_PUBLIC_).
# If none are set, the app runs in dev mode and returns the code in the API
# response (devCode) so you can test the flow locally. NEVER in production.
# ============================================================================

# Supabase SECRET service-role key — required to create sessions after OTP.
# Dashboard → Settings → API → service_role (secret). NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# Secret pepper mixed into the OTP hash (any long random string).
OTP_HASH_PEPPER=

# Fallback order (comma-separated). Remove "sms" until DLT sender-id is ready.
# whatsapp_meta = direct Meta Cloud API; whatsapp/sms/voice = MSG91; voice_plivo = Plivo.
OTP_CHANNEL_ORDER=whatsapp_meta,whatsapp,sms,voice_plivo,voice

# ── Direct Meta WhatsApp Cloud API (primary channel — reuse existing number) ──
WHATSAPP_OTP_PHONE_NUMBER_ID=
WHATSAPP_OTP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANG=en_US
META_GRAPH_API_VERSION=v22.0

# ── MSG91 (WhatsApp + SMS + Voice under one auth key) ──
MSG91_AUTH_KEY=
MSG91_WHATSAPP_TEMPLATE_ID=
MSG91_WHATSAPP_NUMBER=
MSG91_SMS_TEMPLATE_ID=
MSG91_VOICE_TEMPLATE_ID=

# ── Plivo Voice OTP (no DLT needed). PLIVO_OTP_ANSWER_URL points to
#    <your-domain>/api/otp/plivo-answer ──
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
PLIVO_OTP_ANSWER_URL=

# Optional test bypass (app-store review): fixed number + code, skips delivery.
OTP_TEST_PHONE=
OTP_TEST_CODE=

# Kill-switch: set to false to disable OTP entirely.
OTP_ENABLED=true
